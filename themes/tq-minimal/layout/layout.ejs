<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5">
  <title><%= page.title ? page.title + ' | ' + config.author : config.author %></title>
  <meta name="author" content="<%= config.author %>">
  <link rel="icon" href="<%- url_for('/favicon.ico') %>">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
  <link rel="alternate" type="application/atom+xml" href="<%- url_for('/atom.xml') %>" title="<%= config.author %>">
  <% if (page.mathjax) { %>
  <script>window.MathJax = { tex: { inlineMath: [['$', '$'], ['\\(', '\\)']] } };</script>
  <script async src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-mml-chtml.js"></script>
  <% } %>
</head>
<body class="<%= is_home() ? 'home' : '' %>">
  <header>
    <a class="title" href="<%- url_for('/') %>"><h1><%= config.author %></h1></a>
    <nav>
      <p><% Object.keys(theme.nav).forEach(function (name) { %><a href="<%- url_for(theme.nav[name]) %>"><%= name %></a> <% }) %></p>
    </nav>
  </header>
  <main>
<%- body %>
  </main>
  <footer>
    <span>© 2022–<%= new Date().getFullYear() %> <%= config.author %> · Inspired by <a href="https://bearblog.dev">Bear <span role="img" aria-label="ASCII bear logo">ʕ•ᴥ•ʔ</span></a></span>
  </footer>
  <% if (page.content && page.content.includes('class="mermaid"')) { %>
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10.9.1/dist/mermaid.min.js"></script>
  <script>mermaid.initialize({ startOnLoad: true, theme: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'default' });</script>
  <% } %>
</body>
</html>
