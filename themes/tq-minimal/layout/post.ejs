<h1><%= page.title %></h1>
<p><i><time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'D MMM, YYYY') %></time></i></p>
<%- page.content %>
<% if (page.tags && page.tags.length) { %>
<p class="tags"><% page.tags.forEach(function (tag) { %><a href="<%- url_for(tag.path) %>">#<%= tag.name %></a> <% }) %></p>
<% } %>
