<h1><%= page.title %></h1>
<% if (page.type === 'categories') { %>
<ul>
  <% site.categories.sort('name').forEach(function (c) { %><li><a href="<%- url_for(c.path) %>"><%= c.name %></a> (<%= c.length %>)</li><% }) %>
</ul>
<% } else if (page.type === 'tags') { %>
<p><% site.tags.sort('name').forEach(function (t) { %><a href="<%- url_for(t.path) %>">#<%= t.name %></a> <% }) %></p>
<% } else { %>
<%- page.content %>
<% } %>
